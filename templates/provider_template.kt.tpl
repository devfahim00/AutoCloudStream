         2. loadExtractor()               -> CloudStream's built-in extractors
                                             (dood, streamtape, mixdrop, ...)
         3. page scan                     -> media URLs in the page source,
                                             p.a.c.k.e.r / atob / unescape
                                             blobs, player configs
                                             (file: "..."), <video>/<source>,
                                             JSON-LD contentUrl/embedUrl,
                                             subtitles (.vtt / .srt)
         4. nested players                -> iframes / data-* embeds, followed
                                             up to MAX_DEPTH levels
         5. extractViaWebView()           -> WebViewResolver, intercept the
                                             first .m3u8/.mp4 request
       If nothing works, this is where you write the per-site logic.
       ================================================================ */
    override suspend fun loadLinks(
        data: String,
        isCasting: Boolean,
        subtitleCallback: (SubtitleFile) -> Unit,
        callback: (ExtractorLink) -> Unit
    ): Boolean {
{{#telegram}}
        if (data.contains("t.me/")) {
            openTelegram()
            return true
        }
{{/telegram}}
        var emitted = 0
        val tracked: (ExtractorLink) -> Unit = { link ->
            emitted++
            callback(link)
        }
        val seen = HashSet<String>()

        val entries: List<Pair<String, String>> = when {
            data.contains("|||") -> data.split("|||").mapNotNull { p ->
                val x = p.split("@@@"); if (x.size >= 2) x[0] to x[1] else null
            }
            data.contains("@@@") -> {
                val x = data.split("@@@"); if (x.size >= 2) listOf(x[0] to x[1]) else emptyList()
            }
            else -> listOf("Watch" to data)
        }

        entries.forEach { (label, url) ->
            try {
                resolve(url, label, "$mainUrl/", 0, seen, subtitleCallback, tracked)
            } catch (_: Exception) {}
        }

        return emitted > 0
    }

    // ---------- Generic video resolver ----------

    private suspend fun resolve(
        url: String,
        label: String,
        referer: String,
        depth: Int,
        seen: MutableSet<String>,
        subtitleCallback: (SubtitleFile) -> Unit,
        callback: (ExtractorLink) -> Unit
    ): Boolean {
        if (depth > MAX_DEPTH || !seen.add("P:$url")) return false

        // 1) already a media file
        if (DIRECT_MEDIA_RE.containsMatchIn(url)) {
            return emitMedia(url, referer, label, seen, callback)
        }

        // 2) CloudStream's own extractors know hundreds of hosts
        if (isExternal(url)) {
            var hit = false
            try {
                loadExtractor(url, referer, subtitleCallback) { link ->
                    hit = true
                    callback(link)
                }
            } catch (_: Exception) {}
            if (hit) return true
        }

        // 3) scan the page itself
        val html = try { fetchHtml(url, referer) } catch (_: Exception) { "" }
        if (html.isBlank()) {
            return if (depth == 0) extractViaWebView(url, label, referer, seen, callback) else false
        }

        val page = Jsoup.parse(html, url)
        val normalized = html.replace("\\/", "/").replace("\\u0026", "&").replace("&amp;", "&")
        val unpacked = unpackAllPackedScripts(normalized)
        val corpus = buildString {
            append(normalized).append('\n')
            append(unpacked).append('\n')
            append(decodeHiddenBlobs(normalized))
        }

        var any = false

        // a) absolute media URLs anywhere in the source
        for (m in DIRECT_URL_RE.findAll(corpus)) {
            if (emitMedia(m.value, url, label, seen, callback)) any = true
        }
        // b) player configs: file: "...", src = "...", hls_url: "..." (may be relative)
        for (m in KEYED_MEDIA_RE.findAll(corpus)) {
            if (emitMedia(resolveUrl(m.groupValues[1], url), url, label, seen, callback)) any = true
        }
        // c) <video> / <source> tags (extension-less stream URLs are fine here)
        for (el in page.select("video[src], video source[src]")) {
            val src = resolveUrl(el.attr("src"), url)
            if (src.startsWith("http") && emitMedia(src, url, label, seen, callback)) any = true
        }
        // d) relative stream paths inside packed scripts (/stream/.., /hls/..)
        if (unpacked.isNotBlank()) {
            val base = getBaseUrl(url)
            val relRegex = Regex("""["'](/(?:stream|hlsmod|hls|vod)/[^"']+?)["']""")
            for (m in relRegex.findAll(unpacked)) {
                var link = m.groupValues[1]
                if (!link.contains(".m3u8")) link = "$link/master.m3u8"
                if (emitMedia("$base$link", url, label, seen, callback)) any = true
            }
        }
        // e) subtitles found next to the stream
        SUB_URL_RE.findAll(corpus).map { it.value }.distinct().forEach { sub ->
            try { subtitleCallback.invoke(newSubtitleFile(subtitleLang(sub), sub)) } catch (_: Exception) {}
        }
        if (any) return true

        // 4) nested players (iframes, data-* embeds, JSON-LD embedUrl)
        val nested = collectEmbeds(page, url).map { it.second }.toMutableList()
        for (m in EMBED_URL_RE.findAll(corpus)) nested.add(resolveUrl(m.groupValues[1], url))
        val targets = nested.distinct().filter { it != url }.take(MAX_NESTED)

        var nestedFound = false
        for (t in targets) {
            if (resolve(t, label, url, depth + 1, seen, subtitleCallback, callback)) nestedFound = true
        }
        if (nestedFound) return true

        // 5) JS-rendered player: let a WebView play it and intercept the stream.
        //    Only on leaf pages (no nested players) to keep latency bounded.
        return if (targets.isEmpty()) extractViaWebView(url, label, referer, seen, callback) else false
    }

    private suspend fun emitMedia(
        link: String,
        referer: String,
        label: String,
        seen: MutableSet<String>,
        callback: (ExtractorLink) -> Unit
    ): Boolean {
        val clean = link.trim().replace("\\/", "/").replace("&amp;", "&")
        if (!clean.startsWith("http")) return false
        if (JUNK_MEDIA_RE.containsMatchIn(clean) || !seen.add("L:$clean")) return false

        val isM3u8 = clean.contains(".m3u8", true)
        if (isM3u8) {
            // expand master playlists into 1080p / 720p / ... variants
            val variants = try {
                M3u8Helper.generateM3u8(
                    source = "$name - $label",
                    streamUrl = clean,
                    referer = referer
                )
            } catch (_: Exception) { emptyList<ExtractorLink>() }
            if (variants.isNotEmpty()) {
                variants.forEach { callback.invoke(it) }
                return true
            }
        }

        val quality = getQualityFromLabel(label).takeIf { it != Qualities.Unknown.value }
            ?: getQualityFromLabel(clean)
        callback.invoke(newExtractorLink(name, "$name - $label", clean) {
            this.referer = referer
            this.quality = quality
            this.type = if (isM3u8) ExtractorLinkType.M3U8 else ExtractorLinkType.VIDEO
        })
        return true
    }

    private suspend fun extractViaWebView(
        url: String,
        label: String,
        referer: String,
        seen: MutableSet<String>,
        callback: (ExtractorLink) -> Unit
    ): Boolean {
        return try {
            val resolver = WebViewResolver(
                interceptUrl = Regex("""\.(?:m3u8|mp4)(?:\?|$)"""),
                useOkhttp = false,
                timeout = 20_000L,
                script = """
                    (function() {
                        function tryPlay() {
                            try {
                                var v = document.querySelector('video');
                                if (v) { v.muted = true; v.play().catch(function(){}); }
                                var btn = document.querySelector(
                                    'button, .vds-play-button, [aria-label="Play"], [data-media-play-button], .jw-icon-playback'
                                );
                                if (btn) { btn.click(); }
                            } catch (e) {}
                        }
                        tryPlay();
                        setTimeout(tryPlay, 1000);
                        setTimeout(tryPlay, 2500);
                        setTimeout(tryPlay, 4500);
                    })();
                """.trimIndent()
            )
            val response = app.get(url, referer = referer, interceptor = resolver)
            val finalUrl = response.url
            if (DIRECT_MEDIA_RE.containsMatchIn(finalUrl)) {
                emitMedia(finalUrl, url, label, seen, callback)
            } else {
                false
            }
        } catch (_: Exception) {
            false
        }
    }

    // ---------- Embed / metadata collectors ----------

    // Player URLs embedded in a page: iframes (lazy or not) and data-* hints.
    private fun collectEmbeds(doc: org.jsoup.nodes.Document, base: String): List<Pair<String, String>> {
        val out = LinkedHashMap<String, String>()
        val attrs = listOf("src", "data-src", "data-lazy-src", "data-embed", "data-iframe", "data-video", "data-player")
        doc.select("iframe, [data-embed], [data-iframe], [data-video], [data-player]").forEach { el ->
            val raw = attrs.map { el.attr(it).trim() }.firstOrNull {
                it.startsWith("http") || it.startsWith("//") || it.startsWith("/")
            } ?: return@forEach
            val href = resolveUrl(raw, base)
            if (!href.startsWith("http") || JUNK_EMBED_RE.containsMatchIn(href)) return@forEach
            out.putIfAbsent(href, "Player ${out.size + 1}")
        }
        return out.map { it.value to it.key }
    }

    // First JSON-LD node describing a movie / video / series.
    private fun parseJsonLd(doc: org.jsoup.nodes.Document): JSONObject? {
        for (script in doc.select("script[type=application/ld+json]")) {
            val raw = script.data().trim()
            if (raw.isBlank()) continue
            try {
                val nodes = mutableListOf<JSONObject>()
                fun walk(n: Any?) {
                    when (n) {
                        is JSONArray -> for (i in 0 until n.length()) walk(n.opt(i))
                        is JSONObject -> {
                            nodes.add(n)
                            walk(n.optJSONArray("@graph"))
                        }
                    }
                }
                walk(if (raw.startsWith("[")) JSONArray(raw) else JSONObject(raw))
                val hit = nodes.firstOrNull { node ->
                    val type = node.opt("@type")?.toString().orEmpty()
                    LD_TYPES.any { type.contains(it, true) }
                }
                if (hit != null) return hit
            } catch (_: Exception) {}
        }
        return null
    }

    // atob("...") and unescape("%3C...") blobs often hide iframes / stream urls.
    private fun decodeHiddenBlobs(text: String): String {
        val sb = StringBuilder()
        for (m in ATOB_RE.findAll(text)) {
            try {
                val bytes = android.util.Base64.decode(m.groupValues[1], android.util.Base64.DEFAULT)
                sb.append(String(bytes, Charsets.UTF_8)).append('\n')
            } catch (_: Exception) {}
        }
        for (m in UNESCAPE_RE.findAll(text)) {
            try {
                sb.append(java.net.URLDecoder.decode(m.groupValues[1], "UTF-8")).append('\n')
            } catch (_: Exception) {}
        }
        return sb.toString()
    }

    private fun resolveUrl(raw: String, base: String): String {
        val r = raw.trim()
        if (r.startsWith("http")) return r
        if (r.startsWith("//")) return "https:$r"
        return try { java.net.URI(base).resolve(r).toString() } catch (_: Exception) { fixUrl(r) }
    }

    private fun subtitleLang(url: String): String {
        val u = url.lowercase()
        return when {
            Regex("""[._/\-](?:en|eng|english)[._/\-]""").containsMatchIn(u) -> "English"
            Regex("""[._/\-](?:bn|ben|bengali)[._/\-]""").containsMatchIn(u) -> "Bengali"
            Regex("""[._/\-](?:hi|hin|hindi)[._/\-]""").containsMatchIn(u) -> "Hindi"
            Regex("""[._/\-](?:ar|ara|arabic)[._/\-]""").containsMatchIn(u) -> "Arabic"
            else -> "Subtitle"
        }
    }

    // ---------- p.a.c.k.e.r unpacker ----------

    private fun unpackAllPackedScripts(html: String): String {
        val sb = StringBuilder()
        val regex = Regex(
            """eval\(function\(p,a,c,k,e,[dr]\)\{.*?\}\('(.*?)',(\d+),(\d+),'(.*?)'\.split\('\|'\)""",
            setOf(RegexOption.DOT_MATCHES_ALL, RegexOption.IGNORE_CASE)
        )
        regex.findAll(html).forEach { m ->
            try {
                val payload = m.groupValues[1]
                val b = m.groupValues[2].toInt()
                val c = m.groupValues[3].toInt()
                val sym = m.groupValues[4].split("|")
                sb.append(unpackPacker(payload, b, c, sym)).append("\n")
            } catch (_: Exception) {}
        }
        return sb.toString()
    }

    private fun unpackPacker(payload: String, base: Int, count: Int, sym: List<String>): String {
        val radix = base.coerceIn(2, 36)
        return Regex("""\b\w+\b""").replace(payload) { m ->
            val word = m.value
            val index = try { word.toInt(radix) } catch (_: Exception) { -1 }
            if (index in sym.indices && sym[index].isNotBlank()) sym[index] else word
        }
    }

    // ---------- Small helpers ----------

    private fun getBaseUrl(url: String): String = try {
        val u = java.net.URL(url); "${u.protocol}://${u.host}"
    } catch (_: Exception) { "" }

    private fun mainHost(): String = try {
        java.net.URI(mainUrl).host ?: ""
    } catch (_: Exception) { "" }

    private fun isExternal(url: String): Boolean = try {
        val host = java.net.URI(url).host
        host != null && host != mainHost()
    } catch (_: Exception) { false }

    private fun getQualityFromLabel(label: String): Int {
        val l = label.lowercase()
        return when {
            l.contains("4k") || l.contains("2160") -> Qualities.P2160.value
            l.contains("1080") -> Qualities.P1080.value
            l.contains("720") -> Qualities.P720.value
            l.contains("480") -> Qualities.P480.value
            l.contains("360") -> Qualities.P360.value
            else -> Qualities.Unknown.value
        }
    }

    private fun fixUrl(url: String): String {
        if (url.isBlank()) return ""
        return when {
            url.startsWith("//") -> "https:$url"
            url.startsWith("/") -> "$mainUrl$url"
            !url.startsWith("http") -> "$mainUrl/$url"
            else -> url
        }
    }

